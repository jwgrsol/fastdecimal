{
  "name": "fastdecimal",
  "version": "0.1.0",
  "description": "BigInt-powered drop-in replacement for big.js with a tree-shakable functional core — dramatically faster arithmetic at every operand size, verified against big.js's own test suite",
  "license": "MIT",
  "repository": "github:jwgrsol/fastdecimal",
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "packageManager": "yarn@4.12.0",
  "workspaces": [
    "bench"
  ],
  "jsdelivr": "./dist/browser.global.js",
  "unpkg": "./dist/browser.global.js",
  "exports": {
    ".": "./src/core/index.ts",
    "./big": "./src/big.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "big.js",
    "big.d.ts"
  ],
  "scripts": {
    "bench": "node bench/run.mjs",
    "build": "tsdown && node scripts/postbuild-cjs-dts.mjs",
    "format": "prettier --write .",
    "lint": "eslint .",
    "check:exports": "yarn pack -o .pack-check.tgz && attw .pack-check.tgz && publint --pack yarn && rm -f .pack-check.tgz",
    "prepack": "yarn build",
    "test": "node test/run-vendored.mjs && vitest run && node test/differential.mjs",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "decimal",
    "arbitrary-precision",
    "big.js",
    "bignumber",
    "bigint",
    "arithmetic",
    "financial"
  ],
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@types/big.js": "^7",
    "@vitest/eslint-plugin": "^1.6.27",
    "big.js": "^7.0.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "publint": "^0.3.23",
    "tsdown": "^0.22.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.mts",
          "default": "./dist/index.mjs"
        },
        "require": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        }
      },
      "./big": {
        "import": {
          "types": "./dist/big.d.mts",
          "default": "./dist/big.mjs"
        },
        "require": {
          "types": "./dist/big.d.ts",
          "default": "./dist/big.js"
        }
      },
      "./package.json": "./package.json"
    }
  }
}
